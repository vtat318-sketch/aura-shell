{
  "$schema": "../../schema/theme.schema.json",
  "formatVersion": 1,
  "id": "neon",
  "name": "Неон",
  "author": "Aura",
  "version": "1.0.0",
  "tags": [
    "киберпанк",
    "яркая"
  ],
  "palette": {
    "accent": "#5CF2FF",
    "surface": "rgba(6,14,24,0.74)",
    "surfaceSolid": "#07111C",
    "text": "#F5F3FF",
    "tile": "rgba(92,242,255,0.07)",
    "border": "rgba(255,255,255,0.10)"
  },
  "taskbar": {
    "layout": "islands",
    "alignment": "left",
    "height": 58,
    "iconSize": 26,
    "radius": 10,
    "blur": 20,
    "hoverEffect": "dock",
    "iconStyle": "tile",
    "toolsGroup": true
  },
  "clock": {
    "showSeconds": false,
    "showDate": true
  },
  "windows": {
    "open": "scale",
    "minimize": "shrink",
    "durationMs": 240
  },
  "wallpaper": {
    "type": "procedural",
    "source": "deep"
  },
  "performance": {
    "pauseOnFullscreen": true,
    "pauseOnBattery": true,
    "ecoMode": false
  }
}
